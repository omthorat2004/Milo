# Public site origin, used for canonical + OG metadata.
# Set to your Vercel URL once deployed, e.g. https://milo-xxxx.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Waitlist storage -------------------------------------------------------
# The first configured option wins:
#   1. MONGODB_URI          -> MongoDB          (production)
#   2. WAITLIST_FORWARD_URL -> HTTP forward     (the FastAPI backend, later)
#   3. development          -> .data/waitlist.json
#   4. production, none set -> structured logs only (signups are NOT durable)

# MongoDB Atlas connection string. Create a free cluster, add a database user,
# and allow access from anywhere (0.0.0.0/0) so Vercel's functions can connect.
MONGODB_URI=""
MONGODB_DB="milo"

# Optional: forward signups to another service instead.
WAITLIST_FORWARD_URL=""
WAITLIST_FORWARD_SECRET=""

# Required to read GET /api/waitlist (signup count). Any long random string.
# Without it the endpoint 404s. The count is never shown publicly.
WAITLIST_ADMIN_TOKEN=""

# Overrides the dev JSON file location.
WAITLIST_DATA_FILE=""
