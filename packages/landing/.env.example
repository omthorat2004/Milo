# Public site origin, used for canonical + OG metadata.
# Set to your Vercel URL once deployed, e.g. https://milo-xxxx.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Waitlist storage -------------------------------------------------------
# MongoDB is the store. Without MONGODB_URI, development falls back to a local
# JSON file at .data/waitlist.json and production logs signups instead, which
# is a misconfiguration, not a supported mode.
#
# Atlas setup: create a free cluster, add a database user, and under Network
# Access allow 0.0.0.0/0 so Vercel's functions can connect. URL-encode the
# password if it contains @ : / ? # [ ] or %.
MONGODB_URI=""
MONGODB_DB="milo"

# Required to read GET /api/waitlist (signup count). Any long random string.
# Without it the endpoint 404s. The count is never shown publicly.
WAITLIST_ADMIN_TOKEN=""

# Overrides the dev JSON file location.
WAITLIST_DATA_FILE=""

# Salt for the rotating hash used to rate-limit by client. Optional; a default
# is used if unset. Raw IPs are never stored or displayed either way.
IP_HASH_SALT=""
