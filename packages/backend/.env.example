ENVIRONMENT=development

# Loaded in order, later files win: .env -> .env.development -> .env.local
# Keep machine-specific overrides and anything secret in .env.local.

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=milo
MONGODB_TIMEOUT_MS=10000

# Required in production, where startup fails without it. In development one is
# generated per process, so restarting invalidates existing tokens.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Comma separated or a JSON array. Cannot contain "*" while credentials are
# allowed: browsers reject that combination outright.
CORS_ORIGINS=http://localhost:3001
CORS_ALLOW_CREDENTIALS=true

# Both derive from ENVIRONMENT when left blank:
#   production  -> secure=true,  samesite=none  (https, cross-site frontend)
#   otherwise   -> secure=false, samesite=lax   (plain http on localhost)
# samesite=none turns off the CSRF protection lax gives for free, so the API
# needs its own CSRF defence once cookies are cross-site.
COOKIE_SECURE=
COOKIE_SAMESITE=
COOKIE_HTTPONLY=true
COOKIE_DOMAIN=
