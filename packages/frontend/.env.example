# Base URL of the FastAPI backend, read by lib/axios.config.ts.
#
# NEXT_PUBLIC_ is required: this value is read in the browser, where only
# NEXT_PUBLIC_* vars exist. It is a public URL, not a secret.
#
# Whatever origin this app is served from must appear in the backend's
# CORS_ORIGINS, or every authenticated request fails a preflight that the
# browser reports to JavaScript as an indistinguishable network error.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Optional server-only override, used when server components reach the backend
# over an internal address the browser cannot resolve. Ignored in the browser.
API_URL=

# Request timeout in milliseconds. Defaults to 15000 when unset or unparseable.
NEXT_PUBLIC_API_TIMEOUT_MS=15000
