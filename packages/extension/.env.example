# Read by `npm run build` and baked into dist/. Copy to .env.local (gitignored) to override.
# Rebuild and reload the extension in chrome://extensions after changing these.

# The FastAPI backend. Becomes the extension's only host permission.
# Must be https unless it is localhost.
MILO_API_URL=http://localhost:8000

# The web app, used for "Open dashboard" and "Create an account".
MILO_APP_URL=http://localhost:3001
